{
  "$defs": {
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "in",
            "contains",
            "gte",
            "lte",
            "between"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "JsonValue": {},
    "UtilityEntry": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "maximum": 99,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "utility": {
          "title": "Utility",
          "type": "number"
        },
        "variant_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "variant_id",
        "quantity",
        "utility"
      ],
      "title": "UtilityEntry",
      "type": "object"
    },
    "UtilitySpec": {
      "additionalProperties": false,
      "properties": {
        "abandonment_utility": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abandonment Utility"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/UtilityEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "kind": {
          "const": "explicit_table",
          "default": "explicit_table",
          "title": "Kind",
          "type": "string"
        },
        "quantity_domain": {
          "items": {
            "maximum": 99,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Quantity Domain",
          "type": "array"
        },
        "reference_scope": {
          "enum": [
            "entire_catalog",
            "specified_eligible_set"
          ],
          "title": "Reference Scope",
          "type": "string"
        }
      },
      "required": [
        "reference_scope",
        "quantity_domain",
        "entries"
      ],
      "title": "UtilitySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_goal": {
      "minLength": 1,
      "title": "Agent Goal",
      "type": "string"
    },
    "catalog_snapshot_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Catalog Snapshot Id",
      "type": "string"
    },
    "optional_utility_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtilitySpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "private_constraints": {
      "items": {
        "$ref": "#/$defs/Constraint"
      },
      "title": "Private Constraints",
      "type": "array"
    },
    "provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Provenance",
      "type": "object"
    },
    "task_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "validation_status": {
      "default": "DRAFT",
      "enum": [
        "DRAFT",
        "VALIDATED"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "version",
    "agent_goal",
    "private_constraints",
    "catalog_snapshot_id",
    "provenance"
  ],
  "title": "TaskVersion",
  "type": "object"
}
