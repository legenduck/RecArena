{
  "additionalProperties": false,
  "description": "A pinned service policy. Its implementation and preparation are provider-owned.",
  "properties": {
    "candidate_limit": {
      "minimum": 1,
      "title": "Candidate Limit",
      "type": "integer"
    },
    "candidate_scope": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Candidate Scope",
      "type": "string"
    },
    "family": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Family",
      "type": "string"
    },
    "policy_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Policy Id",
      "type": "string"
    },
    "service_id": {
      "default": "default",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Service Id",
      "type": "string"
    },
    "version": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "family",
    "policy_id",
    "version",
    "candidate_scope",
    "candidate_limit"
  ],
  "title": "PolicyConfig",
  "type": "object"
}
