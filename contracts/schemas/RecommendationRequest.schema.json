{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "retrieval_rank": {
          "minimum": 1,
          "title": "Retrieval Rank",
          "type": "integer"
        }
      },
      "required": [
        "product_id",
        "retrieval_rank"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateSet": {
      "additionalProperties": false,
      "properties": {
        "candidate_scope": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Scope",
          "type": "string"
        },
        "candidate_set_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Set Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "catalog_snapshot_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Catalog Snapshot Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "query_normalized": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Query Normalized",
          "type": "string"
        },
        "query_raw": {
          "title": "Query Raw",
          "type": "string"
        }
      },
      "required": [
        "candidate_set_id",
        "catalog_snapshot_id",
        "candidate_scope",
        "query_raw",
        "query_normalized",
        "candidates"
      ],
      "title": "CandidateSet",
      "type": "object"
    },
    "JsonValue": {},
    "PolicyConfig": {
      "additionalProperties": false,
      "description": "A pinned service policy. Its implementation and preparation are provider-owned.",
      "properties": {
        "candidate_limit": {
          "minimum": 1,
          "title": "Candidate Limit",
          "type": "integer"
        },
        "candidate_scope": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Scope",
          "type": "string"
        },
        "family": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Family",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "service_id": {
          "default": "default",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Service Id",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "family",
        "policy_id",
        "version",
        "candidate_scope",
        "candidate_limit"
      ],
      "title": "PolicyConfig",
      "type": "object"
    },
    "UserContext": {
      "additionalProperties": false,
      "properties": {
        "history_snapshot_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "History Snapshot Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "history_snapshot_id"
      ],
      "title": "UserContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "catalog_snapshot_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Catalog Snapshot Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyConfig"
    },
    "policy_version_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Policy Version Id",
      "type": "string"
    },
    "query": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "user": {
      "$ref": "#/$defs/UserContext"
    }
  },
  "required": [
    "query",
    "catalog_snapshot_id",
    "user",
    "policy",
    "policy_version_id"
  ],
  "title": "RecommendationRequest",
  "type": "object"
}
