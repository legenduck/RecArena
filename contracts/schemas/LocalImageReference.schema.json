{
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "height": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height"
    },
    "media_type": {
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 33554432,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_index": {
      "minimum": 0,
      "title": "Source Index",
      "type": "integer"
    },
    "source_key": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Source Key",
      "type": "string"
    },
    "source_parent_asin": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Source Parent Asin",
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width"
    }
  },
  "required": [
    "asset_id",
    "source_key",
    "source_parent_asin",
    "source_index",
    "path",
    "size_bytes",
    "media_type"
  ],
  "title": "LocalImageReference",
  "type": "object"
}
