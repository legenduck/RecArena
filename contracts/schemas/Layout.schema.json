{
  "$defs": {
    "GridBlock": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "default": 4,
          "maximum": 12,
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "component": {
          "const": "grid",
          "default": "grid",
          "title": "Component",
          "type": "string"
        },
        "count": {
          "default": 20,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "source": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visibility": {
          "default": "all_pages",
          "enum": [
            "all_pages",
            "first_page"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "title"
      ],
      "title": "GridBlock",
      "type": "object"
    },
    "PagedRowBlock": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "paged_row",
          "default": "paged_row",
          "title": "Component",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "source": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "total_count": {
          "default": 20,
          "minimum": 1,
          "title": "Total Count",
          "type": "integer"
        },
        "visibility": {
          "default": "first_page",
          "enum": [
            "all_pages",
            "first_page"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "visible_count": {
          "default": 5,
          "minimum": 1,
          "title": "Visible Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "source",
        "title"
      ],
      "title": "PagedRowBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abandon_enabled": {
      "default": false,
      "title": "Abandon Enabled",
      "type": "boolean"
    },
    "blocks": {
      "items": {
        "discriminator": {
          "mapping": {
            "grid": "#/$defs/GridBlock",
            "paged_row": "#/$defs/PagedRowBlock"
          },
          "propertyName": "component"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/GridBlock"
          },
          {
            "$ref": "#/$defs/PagedRowBlock"
          }
        ]
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "cart_enabled": {
      "default": false,
      "title": "Cart Enabled",
      "type": "boolean"
    },
    "main_page_size": {
      "default": 20,
      "minimum": 1,
      "title": "Main Page Size",
      "type": "integer"
    },
    "sidebar_enabled": {
      "default": false,
      "title": "Sidebar Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "blocks"
  ],
  "title": "Layout",
  "type": "object"
}
