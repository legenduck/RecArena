{
  "$defs": {
    "PurchaseItem": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "origin_placement_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Placement Id"
        },
        "product_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "maximum": 99,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "selected_options": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Selected Options",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "total_price_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Price Minor"
        },
        "unit_price_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price Minor"
        },
        "variant_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "variant_id",
        "title",
        "selected_options",
        "quantity",
        "unit_price_minor",
        "total_price_minor",
        "currency"
      ],
      "title": "PurchaseItem",
      "type": "object"
    },
    "PurchaseResponse": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Context Id",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/PurchaseItem"
          },
          "title": "Items",
          "type": "array"
        },
        "origin_placement_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Origin Placement Id"
        },
        "product_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Id"
        },
        "purchased_at": {
          "format": "date-time",
          "title": "Purchased At",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "selected_options": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Options"
        },
        "total_price_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Price Minor"
        },
        "total_quantity": {
          "title": "Total Quantity",
          "type": "integer"
        },
        "totals_by_currency": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Totals By Currency",
          "type": "object"
        },
        "unit_price_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price Minor"
        },
        "variant_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Variant Id"
        }
      },
      "required": [
        "request_id",
        "id",
        "run_id",
        "context_id",
        "product_id",
        "variant_id",
        "selected_options",
        "quantity",
        "unit_price_minor",
        "total_price_minor",
        "currency",
        "origin_placement_id",
        "purchased_at",
        "items",
        "total_quantity",
        "totals_by_currency"
      ],
      "title": "PurchaseResponse",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "READY",
        "RUNNING",
        "PURCHASED",
        "ABANDONED",
        "TIMED_OUT",
        "CANCELLED",
        "ERROR",
        "EXPIRED"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Context Id",
      "type": "string"
    },
    "environment_ready": {
      "title": "Environment Ready",
      "type": "boolean"
    },
    "experiment_active": {
      "title": "Experiment Active",
      "type": "boolean"
    },
    "max_quantity": {
      "maximum": 99,
      "minimum": 1,
      "title": "Max Quantity",
      "type": "integer"
    },
    "purchase": {
      "anyOf": [
        {
          "$ref": "#/$defs/PurchaseResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "shop_session_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Shop Session Id",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunState"
        },
        {
          "const": "GENERAL",
          "type": "string"
        }
      ],
      "title": "State"
    }
  },
  "required": [
    "request_id",
    "shop_session_id",
    "context_id",
    "run_id",
    "state",
    "experiment_active",
    "environment_ready",
    "max_quantity",
    "purchase"
  ],
  "title": "ShopSessionResponse",
  "type": "object"
}
