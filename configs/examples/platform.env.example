# Copy to configs/local/platform.env; use your own secrets and addresses.
RECARENA_DATABASE_URL=postgresql+psycopg://recarena:CHANGE_ME@127.0.0.1:5432/recarena
RECARENA_ADMIN_TOKEN=CHANGE_ME_ADMIN
RECARENA_SESSION_API_KEY=CHANGE_ME_SCRIPT
RECARENA_INTERNAL_TOKEN=CHANGE_ME_PROVIDER
RECARENA_PLATFORM_URL=http://127.0.0.1:8010
RECARENA_PLATFORM_PORT=8010
RECARENA_SHOP_URL=http://127.0.0.1:5173
RECARENA_SHOP_PORT=5173
RECARENA_ADMIN_URL=http://127.0.0.1:5174
RECARENA_ADMIN_PORT=5174
RECARENA_SESSION_COOKIE=recarena_session
RECARENA_RECOMMENDATION_SERVICES='{"default":"http://127.0.0.1:8011"}'
RECARENA_ARTIFACT_ROOT=./artifacts
RECARENA_EXPORT_ROOT=./outputs/exports
# Optional: RECARENA_ASSET_CONFIG=./configs/local/assets.json
